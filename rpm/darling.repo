# As rpmbuild lays out RPMS/. The x86-64 build makes the noarch packages, so aarch64 needs them too.
[darling]
name=Darling
baseurl=file:///data/git/darling-update/rpm/RPMS/$basearch
enabled=1
gpgcheck=0

[darling-noarch]
name=Darling (architecture-independent packages)
baseurl=file:///data/git/darling-update/rpm/RPMS/noarch
enabled=1
gpgcheck=0
