"""Generate Linux desktop entries for applications installed in a Darling prefix.

The MIME types come from the guest's own declarations: CoreTypes.bundle supplies the UTI database and
each application's Info.plist says which UTIs it opens. No application is named here, so applications
installed later are picked up the next time this runs.

Usage:
  darling-desktop [--prefix DIR] [--output-dir DIR] [--app-dir DIR]... [--core-types FILE]

The default output directory is $XDG_DATA_HOME/applications (or ~/.local/share/applications).
"""
import argparse
import hashlib
import mimetypes
import os
import plistlib
import re
import sys
from pathlib import Path

CORE_TYPES = Path("libexec/darling/System/Library/CoreServices/CoreTypes.bundle/Contents/Info.plist")
APP_DIRS = (
    Path("libexec/darling/Applications"),
    Path("libexec/darling/System/Applications"),
    Path("libexec/darling/System/Library/CoreServices"),
)
MARKER = "# Generated by darling-desktop; changes will be overwritten."

# These UTIs are deliberately broad: mapping a document type to one of their MIME types would offer an
# application as the handler for every file on the desktop, which is not what its declaration means.
BROAD_MIME_TYPES = {"application/octet-stream"}

# CoreTypes declares these UTIs without a MIME tag. The mappings are properties of the public UTIs,
# not of any application, and let a type such as public.text be offered to a text editor.
FALLBACK_MIME_TYPES = {
    "public.text": ("text/plain",),
    "public.data": ("application/octet-stream",),
}


def as_list(value):
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return [item for item in value if isinstance(item, str)]
    if isinstance(value, str):
        return [value]
    return []


def as_dicts(value):
    if isinstance(value, dict):
        return [value]
    if isinstance(value, (list, tuple)):
        return [item for item in value if isinstance(item, dict)]
    return []


def one_line(value):
    return " ".join(str(value).split())


def desktop_quote(value):
    """Quotes one Exec argument as the Desktop Entry specification requires."""
    escaped = one_line(value).replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`")
    return '"' + escaped.replace("%", "%%") + '"'


def read_plist(path):
    try:
        with open(path, "rb") as fp:
            return plistlib.load(fp)
    except (OSError, ValueError, plistlib.InvalidFileException) as error:
        print(f"darling-desktop: cannot read {path}: {error}", file=sys.stderr)
        return {}


class UTIDatabase:
    """The public UTI declarations of a Darling guest, including their tag and conformance data."""

    def __init__(self, declarations=()):
        self.declarations = {}
        self.extensions = {}

        for declaration in as_dicts(declarations):
            identifier = declaration.get("UTTypeIdentifier")
            if not isinstance(identifier, str):
                continue
            tags = declaration.get("UTTypeTagSpecification")
            tags = tags if isinstance(tags, dict) else {}
            mime_types = as_list(tags.get("public.mime-type"))
            conforms_to = as_list(declaration.get("UTTypeConformsTo"))
            self.declarations[identifier] = (conforms_to, mime_types)
            for extension in as_list(tags.get("public.filename-extension")):
                self.extensions.setdefault(extension.lower().lstrip("."), identifier)

    @classmethod
    def from_plist(cls, path):
        data = read_plist(path)
        return cls(as_dicts(data.get("UTExportedTypeDeclarations")) + as_dicts(data.get("UTImportedTypeDeclarations")))

    def mime_types(self, identifier):
        result = []
        seen = set()

        def visit(uti):
            if uti in seen:
                return
            seen.add(uti)
            conforms_to, direct = self.declarations.get(uti, ([], []))
            for mime_type in direct:
                if mime_type not in result:
                    result.append(mime_type)
            for parent in conforms_to:
                visit(parent)
            for mime_type in FALLBACK_MIME_TYPES.get(uti, ()):
                if mime_type not in result:
                    result.append(mime_type)

        visit(identifier)
        return result

    def mime_types_for_extension(self, extension):
        identifier = self.extensions.get(extension.lower().lstrip("."))
        if identifier is not None:
            return self.mime_types(identifier)
        guessed = mimetypes.guess_type("file." + extension.lstrip("."))[0]
        return [guessed] if guessed else []


def application_mime_types(info, uti_database):
    result = []

    def add(mime_type):
        if mime_type and mime_type not in result:
            result.append(mime_type)

    for document in as_dicts(info.get("CFBundleDocumentTypes")):
        for identifier in as_list(document.get("LSItemContentTypes")):
            for mime_type in uti_database.mime_types(identifier):
                add(mime_type)
        for mime_type in as_list(document.get("CFBundleTypeMIMETypes")):
            add(mime_type)
        for extension in as_list(document.get("CFBundleTypeExtensions")):
            for mime_type in uti_database.mime_types_for_extension(extension):
                add(mime_type)

    return [mime_type for mime_type in result if mime_type not in BROAD_MIME_TYPES]


def desktop_id(info, app_path, used):
    raw = info.get("CFBundleIdentifier") or info.get("CFBundleName") or app_path.stem
    base = re.sub(r"[^A-Za-z0-9._-]+", "-", one_line(raw)).strip("-._")
    if not base:
        base = hashlib.sha256(str(app_path).encode()).hexdigest()[:16]
    candidate = "darling-" + base
    if candidate in used:
        candidate += "-" + hashlib.sha256(str(app_path).encode()).hexdigest()[:8]
    used.add(candidate)
    return candidate


def desktop_entry(name, launcher, mime_types):
    lines = [
        MARKER,
        "[Desktop Entry]",
        "Type=Application",
        "Name=" + one_line(name),
        "Comment=" + one_line("Run " + one_line(name) + " in Darling"),
        "Exec=" + desktop_quote(str(launcher)) + " open -a " + desktop_quote(name) + " %F",
        "Terminal=false",
    ]
    if mime_types:
        lines.append("MimeType=" + ";".join(mime_types) + ";")
    return "\n".join(lines) + "\n"


def find_applications(directories):
    for directory in directories:
        if not directory.is_dir():
            continue
        for child in sorted(directory.iterdir()):
            if child.is_dir() and child.suffix.lower() == ".app":
                yield child


def generate_entries(prefix, output_dir, app_dirs, core_types_path):
    prefix = Path(prefix).expanduser()
    output_dir = Path(output_dir).expanduser()
    launcher = prefix / "bin" / "darling"
    uti_database = UTIDatabase.from_plist(core_types_path)
    used_ids = set()
    generated = []

    output_dir.mkdir(parents=True, exist_ok=True)
    for old_entry in output_dir.glob("*.desktop"):
        try:
            if old_entry.read_text().startswith(MARKER):
                old_entry.unlink()
        except (OSError, UnicodeError):
            pass

    for app_path in find_applications(app_dirs):
        info = read_plist(app_path / "Contents" / "Info.plist")
        name = one_line(info.get("CFBundleDisplayName") or info.get("CFBundleName") or app_path.stem)
        entry = desktop_entry(name, launcher, application_mime_types(info, uti_database))
        path = output_dir / (desktop_id(info, app_path, used_ids) + ".desktop")
        path.write_text(entry)
        generated.append(path)

    return generated


def default_prefix():
    parent = Path(__file__).resolve().parent.parent
    return parent if (parent / "bin" / "darling").is_file() else None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prefix", default=os.environ.get("DARLING_INSTALL_PREFIX") or default_prefix(),
                        help="Darling installation prefix (also read from DARLING_INSTALL_PREFIX)")
    parser.add_argument("--output-dir", help="directory for the generated desktop entries")
    parser.add_argument("--app-dir", action="append", default=[], help="extra directory to scan for .app bundles")
    parser.add_argument("--core-types", help="CoreTypes.bundle Info.plist with the UTI declarations")
    args = parser.parse_args(argv)

    if args.prefix is None:
        parser.error("give --prefix or set DARLING_INSTALL_PREFIX")

    prefix = Path(args.prefix).expanduser()
    if args.output_dir is None:
        data_home = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
        args.output_dir = Path(data_home) / "applications"
    if args.core_types is None:
        args.core_types = prefix / CORE_TYPES
    app_dirs = [Path(path) for path in args.app_dir] or [prefix / path for path in APP_DIRS]

    generated = generate_entries(prefix, args.output_dir, app_dirs, args.core_types)
    for path in generated:
        print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
