# Run with: cmake -P tests/architecture.cmake
# Checks DARLING_ARCHS, the variables generate_architecture() derives from it and the per-architecture
# helpers of cmake/architecture.cmake.
get_filename_component(here "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${here}/../cmake/architecture.cmake")

# Used by the checks at the bottom, which run this file again with one of these set: each must fail.
if (DEFINED UNKNOWN_TRIPLE)
	darling_arch_triple("${UNKNOWN_TRIPLE}" ignored)
	return()
endif()
if (DEFINED BAD_ARCHS)
	set(DARLING_ARCHS "${BAD_ARCHS}")
	generate_architecture()
	return()
endif()

function(expect what actual expected)
	if (NOT "${actual}" STREQUAL "${expected}")
		message(SEND_ERROR "${what}: '${actual}', expected '${expected}'")
	endif()
endfunction()

# check_archs(<DARLING_ARCHS> <CMAKE_SYSTEM_PROCESSOR> <normalized> <primary> <32-bit arch> <64-bit arch>)
function(check_archs archs processor normalized primary arch32 arch64)
	set(DARLING_ARCHS "${archs}")
	set(CMAKE_SYSTEM_PROCESSOR "${processor}")
	generate_architecture()
	set(what "DARLING_ARCHS='${archs}' on ${processor}")
	expect("${what}: DARLING_ARCHS" "${DARLING_ARCHS}" "${normalized}")
	expect("${what}: APPLE_ARCH_PRIMARY" "${APPLE_ARCH_PRIMARY}" "${primary}")
	darling_arch_triple(${primary} primary_triple)
	expect("${what}: APPLE_TARGET_TRIPLET_PRIMARY" "${APPLE_TARGET_TRIPLET_PRIMARY}" "${primary_triple}")
	expect("${what}: APPLE_ARCH_32BIT" "${APPLE_ARCH_32BIT}" "${arch32}")
	expect("${what}: APPLE_ARCH_64BIT" "${APPLE_ARCH_64BIT}" "${arch64}")

	foreach (pair IN ITEMS i386:i386 x86_64:x86_64 ARM64:arm64)
		string(REPLACE ":" ";" pair "${pair}")
		list(GET pair 0 suffix)
		list(GET pair 1 arch)
		if (arch IN_LIST normalized)
			expect("${what}: TARGET_${suffix}" "${TARGET_${suffix}}" "TRUE")
		else()
			expect("${what}: TARGET_${suffix}" "${TARGET_${suffix}}" "FALSE")
		endif()
	endforeach()

	set(expected_32 "")
	set(expected_64 "")
	foreach (arch IN LISTS normalized)
		if (arch STREQUAL "i386")
			list(APPEND expected_32 ${arch})
		else()
			list(APPEND expected_64 ${arch})
		endif()
	endforeach()
	expect("${what}: DARLING_ARCHS_32BIT" "${DARLING_ARCHS_32BIT}" "${expected_32}")
	expect("${what}: DARLING_ARCHS_64BIT" "${DARLING_ARCHS_64BIT}" "${expected_64}")
	if (expected_32)
		expect("${what}: BUILD_TARGET_32BIT" "${BUILD_TARGET_32BIT}" "TRUE")
	else()
		expect("${what}: BUILD_TARGET_32BIT" "${BUILD_TARGET_32BIT}" "FALSE")
	endif()
	if (expected_64)
		expect("${what}: BUILD_TARGET_64BIT" "${BUILD_TARGET_64BIT}" "TRUE")
	else()
		expect("${what}: BUILD_TARGET_64BIT" "${BUILD_TARGET_64BIT}" "FALSE")
	endif()
endfunction()

# The defaults of an x86-64 and an arm64 host
check_archs("i386;x86_64" x86-64 "i386;x86_64" x86_64 i386 x86_64)
check_archs("arm64" aarch64 "arm64" arm64 "" arm64)
# Single slices
check_archs("x86_64" x86-64 "x86_64" x86_64 "" x86_64)
check_archs("i386" x86-64 "i386" i386 i386 "")
# Two 64-bit slices: the primary one follows the Linux side of Darling
check_archs("x86_64;arm64" x86-64 "x86_64;arm64" x86_64 "" x86_64)
check_archs("x86_64;arm64" aarch64 "x86_64;arm64" arm64 "" arm64)
check_archs("i386;x86_64;arm64" x86-64 "i386;x86_64;arm64" x86_64 i386 x86_64)
check_archs("i386;x86_64;arm64" aarch64 "i386;x86_64;arm64" arm64 i386 arm64)
# Given in another order or twice: the canonical order, once each
check_archs("arm64;x86_64;i386" x86-64 "i386;x86_64;arm64" x86_64 i386 x86_64)
check_archs("arm64;i386;arm64" x86-64 "i386;arm64" arm64 i386 arm64)
# The slice of the Linux side is not built: the first 64-bit slice, else the first slice
check_archs("arm64" x86-64 "arm64" arm64 "" arm64)
check_archs("i386;x86_64" aarch64 "i386;x86_64" x86_64 i386 x86_64)

function(check_helpers arch triple is_64bit family objc_abi)
	darling_arch_triple(${arch} actual_triple)
	darling_arch_is_64bit(${arch} actual_is_64bit)
	darling_arch_family(${arch} actual_family)
	darling_arch_objc_abi(${arch} actual_objc_abi)
	expect("${arch}: triple" "${actual_triple}" "${triple}")
	expect("${arch}: is_64bit" "${actual_is_64bit}" "${is_64bit}")
	expect("${arch}: family" "${actual_family}" "${family}")
	expect("${arch}: objc_abi" "${actual_objc_abi}" "${objc_abi}")
endfunction()

check_helpers(i386 "i386-apple-darwin20" FALSE x86 "legacy")
check_helpers(x86_64 "x86_64-apple-darwin20" TRUE x86 "modern")
check_helpers(arm64 "aarch64-apple-darwin20" TRUE arm "modern")

foreach (pair IN ITEMS aarch64:arm64 arm64:arm64 x86-64:x86_64 x86_64:x86_64 AMD64:x86_64 i686:i386 riscv64:)
	string(REPLACE ":" ";" pair "${pair}")
	list(GET pair 0 processor)
	list(LENGTH pair n)
	if (n GREATER 1)
		list(GET pair 1 expected)
	else()
		set(expected "")
	endif()
	darling_arch_from_processor(${processor} actual)
	expect("darling_arch_from_processor(${processor})" "${actual}" "${expected}")
endforeach()

# Selecting slices
set(DARLING_ARCHS "i386;x86_64;arm64")
darling_archs(all)
expect("darling_archs()" "${all}" "i386;x86_64;arm64")
darling_archs(only_32 32BIT_ONLY)
expect("darling_archs(32BIT_ONLY)" "${only_32}" "i386")
darling_archs(only_64 64BIT_ONLY)
expect("darling_archs(64BIT_ONLY)" "${only_64}" "x86_64;arm64")
darling_archs(intel FAMILY x86)
expect("darling_archs(FAMILY x86)" "${intel}" "i386;x86_64")
darling_archs(intel_64 64BIT_ONLY FAMILY x86)
expect("darling_archs(64BIT_ONLY FAMILY x86)" "${intel_64}" "x86_64")
darling_archs(arm_32 32BIT_ONLY FAMILY arm)
expect("darling_archs(32BIT_ONLY FAMILY arm)" "${arm_32}" "")
darling_archs(given 64BIT_ONLY ARCHS i386 arm64)
expect("darling_archs(64BIT_ONLY ARCHS i386 arm64)" "${given}" "arm64")
darling_archs(none ARCHS)
expect("darling_archs(ARCHS)" "${none}" "")

# Flags
darling_arch_flags(flags i386 x86_64 arm64)
expect("darling_arch_flags" "${flags}" "-arch i386 -arch x86_64 -arch arm64")
darling_arch_flags(no_flags)
expect("darling_arch_flags()" "${no_flags}" "")
darling_xarch_options(xarch ARCHS i386 x86_64 OPTIONS -msse -msse2)
expect("darling_xarch_options" "${xarch}"
	"SHELL:-Xarch_i386 -msse;SHELL:-Xarch_i386 -msse2;SHELL:-Xarch_x86_64 -msse;SHELL:-Xarch_x86_64 -msse2")
darling_xarch_options(no_xarch ARCHS OPTIONS -msse)
expect("darling_xarch_options(no ARCHS)" "${no_xarch}" "")
darling_xarch_flags(xflags ARCHS x86_64 arm64 OPTIONS -Wl,-alias_list,a.alias)
expect("darling_xarch_flags" "${xflags}"
	"-Xarch_x86_64 -Wl,-alias_list,a.alias -Xarch_arm64 -Wl,-alias_list,a.alias")
darling_xarch_flags(no_xflags ARCHS OPTIONS -msse)
expect("darling_xarch_flags(no ARCHS)" "${no_xflags}" "")

# Errors: an architecture that is not described, and no architecture at all
function(expect_failure define message_regex)
	execute_process(
		COMMAND ${CMAKE_COMMAND} "-D${define}" -P "${CMAKE_CURRENT_LIST_FILE}"
		RESULT_VARIABLE result
		ERROR_VARIABLE error
		OUTPUT_QUIET)
	if (result EQUAL 0 OR NOT error MATCHES "${message_regex}")
		message(SEND_ERROR "-D${define} must be rejected with '${message_regex}' (exit ${result}): ${error}")
	endif()
endfunction()

expect_failure("UNKNOWN_TRIPLE=ppc" "unknown architecture 'ppc'")
expect_failure("BAD_ARCHS=x86_64;ppc" "DARLING_ARCHS: unknown architecture 'ppc'")
expect_failure("BAD_ARCHS=" "DARLING_ARCHS is empty")
