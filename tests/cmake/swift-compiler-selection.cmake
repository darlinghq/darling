cmake_minimum_required(VERSION 3.25)
if(NOT TEST_WORK_DIR)
    message(FATAL_ERROR "TEST_WORK_DIR required")
endif()
set(root "${TEST_WORK_DIR}/tool")
file(MAKE_DIRECTORY "${root}/usr/bin" "${root}/usr/lib/swift/shims" "${root}/usr/lib/clang")
foreach(name swiftc swiftc-legacy-driver)
    file(WRITE "${root}/usr/bin/${name}" "#!/bin/sh\nprintf 'Swift version 6.3.3 (owned fixture)\\n'\n")
    file(CHMOD "${root}/usr/bin/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
endforeach()
set(SWIFT_TOOLCHAIN "${root}")
if(NOT MODE STREQUAL "default")
    set(SWIFT_COMPILER_EXECUTABLE "${root}/usr/bin/swiftc-legacy-driver")
endif()
if(MODE STREQUAL "off")
    set(SWIFT_TOOLCHAIN OFF)
elseif(MODE STREQUAL "relative")
    set(SWIFT_COMPILER_EXECUTABLE relative-driver)
elseif(MODE STREQUAL "missing")
    set(SWIFT_COMPILER_EXECUTABLE "${root}/usr/bin/absent")
elseif(MODE STREQUAL "directory")
    set(SWIFT_COMPILER_EXECUTABLE "${root}/usr/bin")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/swift_toolchain.cmake")
if(MODE STREQUAL "off")
    if(SWIFT_TOOLCHAIN_FOUND)
        message(FATAL_ERROR "OFF did not disable compiler")
    endif()
else()
    if(NOT SWIFT_TOOLCHAIN_FOUND)
        message(FATAL_ERROR "Valid compiler was not selected")
    endif()
    if(MODE STREQUAL "default")
        set(expected "${root}/usr/bin/swiftc")
    else()
        set(expected "${root}/usr/bin/swiftc-legacy-driver")
    endif()
    if(NOT SWIFT_COMPILER STREQUAL expected)
        message(FATAL_ERROR "Unexpected compiler selection")
    endif()
    if(MODE STREQUAL "changed-root")
        set(SWIFT_TOOLCHAIN "${TEST_WORK_DIR}/other-root")
        include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/swift_toolchain.cmake")
        if(NOT SWIFT_TOOLCHAIN_FOUND OR NOT SWIFT_COMPILER STREQUAL expected)
            message(FATAL_ERROR "Changed search root erased explicit selection")
        endif()
    endif()
endif()
