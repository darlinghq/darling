"""

HEADER = """{license}
#ifndef _{name}_H_
#define _{name}_H_

/* Intentionally empty: see src/{name}.c. */

#endif
"""

SOURCE = """{license}
#include <stdio.h>
#include <stdlib.h>

/* Stub. As of {date}, these binaries link {name} but bind no symbol from it, so an
   exporting stub is unnecessary:
{evidence}
   A strong bind to a symbol this framework does not export still aborts in dyld, which is
   the intended loud failure. Re-run tools/darling-tier1-stub-gen after an OS update to
   check that this still holds. */

__attribute__((constructor))
static void {name}_stub_loaded(void)
{{
	if (getenv("STUB_VERBOSE"))
		fprintf(stderr, "STUB: {name} loaded (no symbols implemented)\\n");
}}
"""

CMAKELISTS = """project({name})

{remove_call}

set(DYLIB_COMPAT_VERSION "{compat}")
set(DYLIB_CURRENT_VERSION "{current}")

set(FRAMEWORK_VERSION "{version}")

generate_sdk_framework({name}
    VERSION ${{FRAMEWORK_VERSION}}
    HEADER "include/{name}"{private_arg}
)

add_framework({name}
    FAT
    CURRENT_VERSION{private_arg}
    VERSION ${{FRAMEWORK_VERSION}}

    SOURCES
        src/{name}.c

    DEPENDENCIES
        system
)
"""


def emit(root, name, kind, version, apps, compat, current, date, dry_run):
    subdir = "frameworks" if kind == "Frameworks" else "private-frameworks"
    base = os.path.join(root, "src", subdir, name)
    if os.path.exists(base):
        return "exists"
    private = kind == "PrivateFrameworks"
    private_arg = "\n    PRIVATE" if private else ""
    remove_call = ("remove_sdk_framework(%s\n    PRIVATE\n)" % name if private
                   else "remove_sdk_framework(%s)" % name)
    license = LICENSE.format(year=date[:4])
    evidence = "\n".join("     %s.app" % a for a in sorted(apps))
    files = {
        "CMakeLists.txt": CMAKELISTS.format(name=name, version=version, compat=compat, current=current,
                                            private_arg=private_arg, remove_call=remove_call),
        os.path.join("include", name, name + ".h"): HEADER.format(license=license, name=name),
        os.path.join("src", name + ".c"): SOURCE.format(license=license, name=name,
                                                        date=date, evidence=evidence),
    }
    if not dry_run:
        for rel, content in files.items():
            path = os.path.join(base, rel)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(content)
    return "created"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--prefix", required=True, help="Darling prefix holding /Applications")
    ap.add_argument("--out", required=True, help="Darling source root")
    ap.add_argument("--arch", default=None, help="override the per-binary slice")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    for tool in ("llvm-otool", "llvm-objdump"):
        if not shutil.which(tool):
            sys.exit("%s not found on PATH" % tool)

    date = datetime.date.today().isoformat()
    candidates = scan(args.prefix, args.arch)
    if not candidates:
        print("no tier-1 candidates under %s" % args.prefix)
        return

    created, skipped, unhandled = [], [], []
    for install_name in sorted(candidates):
        m = None if install_name.startswith(IOSSUPPORT) else FRAMEWORK_RE.match(install_name)
        if not m:
            # iOSSupport needs add_framework's IOSSUPPORT flag, which no framework uses yet;
            # anything else here is a plain dylib, which needs add_darling_library instead.
            unhandled.append(install_name)
            continue
        name, kind, version = m.group("name"), m.group("kind"), m.group("ver")
        apps, compat, current = candidates[install_name]
        vstr = lambda t: ".".join(str(x) for x in t)
        result = emit(args.out, name, kind, version, apps,
                      vstr(compat), vstr(current), date, args.dry_run)
        (created if result == "created" else skipped).append((name, kind))

    print("scanned %s (%s), %s" % (args.prefix, args.arch or "all slices", date))
    print("tier-1 candidates: %d" % len(candidates))
    print("%s: %d framework(s)" % ("would create" if args.dry_run else "created", len(created)))
    if skipped:
        print("already present, left alone: %d" % len(skipped))
    if unhandled:
        print("\nnot generated (%d) - not a plain framework install name:" % len(unhandled))
        for n in unhandled:
            print("    %s" % n)

    if created:
        print("\nadd these to the matching CMakeLists.txt:")
        for subdir, label in (("Frameworks", "src/frameworks/CMakeLists.txt"),
                              ("PrivateFrameworks", "src/private-frameworks/CMakeLists.txt")):
            names = sorted(n for n, k in created if k == subdir)
            if names:
                print("  %s" % label)
                for n in names:
                    print("    add_subdirectory(%s)" % n)
        print("\nthen reconfigure once with -DREGENERATE_SDK=ON and commit the SDK symlinks.")


if __name__ == "__main__":
    main()
