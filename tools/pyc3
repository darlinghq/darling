#!/usr/bin/env python3

import py_compile
import sys

if len(sys.argv) not in (3, 4):
    sys.exit("usage: pyc3 SOURCE OUTPUT [DISPLAY_NAME]")

source, output = sys.argv[1:3]
display_name = sys.argv[3] if len(sys.argv) == 4 else source

py_compile.compile(source, cfile=output, dfile=display_name, doraise=True)
